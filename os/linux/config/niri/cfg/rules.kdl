window-rule {
    match app-id="com.onepassword.OnePassword"
    match app-id="org.pulseaudio.pavucontrol"
    match app-id="nm-connection-editor"
    match app-id="blueman-manager"
    match app-id="mpv"
    match title="^Welcome to Android Studio$" // xev
    match title="^Select Folder$" // xev
    match title="^Open$" // xev
    match app-id="org.gnome.Nautilus"
    match app-id="org.gnome.Calculator"
    match app-id="nemo"
    match app-id="Nemo-preview-start"
    open-floating true // Always float Firefox PiP windows
    default-window-height { proportion 0.6; }
    default-column-width { proportion 0.6; }
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id=r#"brave-browser$"# title="^Picture in picture$"
    open-floating true // Always float Firefox PiP windows
    default-window-height { proportion 0.25; }
    default-column-width { proportion 0.25; }
    default-floating-position x=1400 y=720 relative-to="top-left"
}

window-rule {
    match is-active=false
    opacity 0.7
}

window-rule {
    geometry-corner-radius 10 // Set every window radius to 20
    clip-to-geometry true
}

// Open Firefox maximized and on the "browser" workspace
window-rule {
    match app-id="firefox"
    // match app-id="Alacritty"
    match app-id="campilot"
    match app-id="ai.storyteller.figcraft"
    match app-id="io.tangencylabs.solidcraft"
    match app-id="FreeCAD"
    match app-id="org.QCAD.qcad-bin"
    match app-id="code"
    match app-id="code-insiders"
    match app-id="jetbrains-studio"
    match app-id="kicad"
    match app-id="crate-app"
    match app-id="DB Browser for SQLite"

    //open-on-workspace "browser"
    open-maximized true
    // default-column-width {}
}

window-rule {
    background-effect {
      blur true
      xray false
    }
}

// Floating Noctalia settings window.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    match title="^Compare presets$" // xev
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
      xray false
      // blur false
    }
}

layer-rule {
    match namespace="dms:blurwallpaper"
    place-within-backdrop true
}

window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}
