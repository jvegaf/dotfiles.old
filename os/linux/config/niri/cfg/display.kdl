// ────────────── Output Configuration ──────────────
// You can run `niri msg outputs` to get the correct name for your displays.

output "BOE 0x0747 Unknown" {
    mode "1920x1080@60" // Set resolution and refresh rate
    scale 1
}

output "eDP-1" {
    mode "2560x1440@60" // Set resolution and refresh rate
    scale 1.33 // No scaling (use 2 for HiDPI)
}

